{
  "name": "@veksa/reselect-utils",
  "version": "5.1.0-p15",
  "files": [
    "src",
    "dist"
  ],
  "main": "./dist/cjs/index.js",
  "types": "./dist/reselectUtils.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/reselectUtils.d.ts",
      "import": "./dist/reselectUtils.mjs",
      "default": "./dist/cjs/index.js"
    }
  },
  "scripts": {
    "build": "yarn clean && tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:types": "tsc --noEmit -p _type-tests/tsconfig.json",
    "lint": "oxlint src/",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "compile": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.0.3",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@veksa/re-reselect": "^5.1.3",
    "@veksa/react-redux": "^9.3.1",
    "@veksa/reselect": "^5.2.1",
    "@vitest/coverage-v8": "^4.1.10",
    "expect-type": "^1.2.1",
    "jsdom": "^30.0.0",
    "lint-staged": "^15.2.10",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "tsdown": "^0.22.14",
    "tslib": "^2.8.1",
    "typescript": "7.0.2",
    "uuid": "^14.0.1",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@veksa/re-reselect": "^5.1.3",
    "@veksa/react-redux": "^9.3.1",
    "@veksa/reselect": "^5.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "lint-staged": {
    "**/*.{js,ts,tsx}": [
      "oxfmt",
      "oxlint --fix",
      "vitest related --run --bail=1"
    ]
  },
  "packageManager": "yarn@4.17.1"
}
